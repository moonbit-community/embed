///|
fn[A] die(message : String) -> A {
  @miniio.stderr.write_text("error: " + message + "\n") catch {
    _ => ()
  }
  @miniio.exit(1)
  panic()
}

///|
fn usage() -> String {
  let text =
    #|Usage: embed-files <dir>
    #|
    #|Read all UTF-8 files under <dir> recursively and write <dir>_bundle.mbt.
    #|
  text
}

///|
fn path_join(base : String, child : String) -> String {
  @path.Path::join(base, child).to_string()
}

///|
fn normalize_path(path : String) -> String {
  @path.Path(path).normalize().to_string()
}

///|
fn dir_basename(path : String) -> String {
  @path.Path(path).normalize().basename().to_owned()
}

///|
fn output_path_for_dir(dir : String) -> String {
  normalize_path(dir) + "_bundle.mbt"
}

///|
fn is_identifier_char(ch : Char) -> Bool {
  ch.is_ascii_alphabetic() || ch.is_ascii_digit()
}

///|
fn sanitize_identifier(raw : String) -> String {
  let buf = StringBuilder()
  let mut wrote = false
  let mut last_was_separator = false
  for ch in raw.to_array() {
    if is_identifier_char(ch) {
      if !wrote && ch.is_ascii_digit() {
        buf.write_string("v_")
      }
      buf.write_char(ch.to_ascii_lowercase())
      wrote = true
      last_was_separator = false
    } else if wrote && !last_was_separator {
      buf.write_char('_')
      last_was_separator = true
    }
  }
  if !wrote {
    "bundle"
  } else {
    buf.to_string()
  }
}

///|
fn bundle_prefix(dir : String) -> String {
  let base = sanitize_identifier(dir_basename(dir))
  if base == "bundle" {
    "dir"
  } else {
    base
  }
}

///|
fn contains_name(names : Array[String], name : String) -> Bool {
  for existing in names {
    if existing == name {
      return true
    }
  }
  false
}

///|
fn unique_name(base : String, names : Array[String]) -> String {
  let mut candidate = base
  let mut suffix = 2
  while contains_name(names, candidate) {
    candidate = base + "_" + suffix.to_string()
    suffix += 1
  }
  names.push(candidate)
  candidate
}

///|
fn relative_path(root : String, file : String) -> String {
  @path.Path(file).relative(base=@path.Path(root)).to_string()
}

///|
fn collect_files(
  root : String,
  dir : String,
  output_path : String,
  files : Array[(String, String)],
) -> Unit raise {
  let normalized_output = normalize_path(output_path)
  for name in @miniio.readdir(dir, include_hidden=true, sort=true) {
    let child = path_join(dir, name)
    if normalize_path(child) != normalized_output {
      if @miniio.is_dir(child) {
        collect_files(root, child, output_path, files)
      } else {
        let content = @miniio.read_text_file(child)
        files.push((relative_path(root, child), content))
      }
    }
  }
}

///|
fn read_bundle_entries(
  dir : String,
  output_path : String,
) -> Array[(String, String)] raise {
  guard @miniio.is_dir(dir) else { die(dir + " is not a directory") }
  let entries : Array[(String, String)] = []
  collect_files(normalize_path(dir), normalize_path(dir), output_path, entries)
  entries
}

///|
fn write_literal_lines(buf : StringBuilder, content : String) -> Unit {
  for line in content.split("\n") {
    buf.write_string("  #|")
    buf.write_view(line)
    buf.write_string("\n")
  }
}

///|
fn render_bundle(dir : String, files : Array[(String, String)]) -> String {
  let prefix = bundle_prefix(dir)
  let names : Array[String] = []
  let buf = StringBuilder()
  buf.write_string("///| Generated by moonbit-community/embed-files from ")
  buf.write_string(dir)
  buf.write_string(".\n\n")
  for entry in files {
    let relative = entry.0
    let content = entry.1
    let name = unique_name(sanitize_identifier(prefix + "_" + relative), names)
    buf.write_string("///|\n")
    buf.write_string("let ")
    buf.write_string(name)
    buf.write_string(" : String =\n")
    write_literal_lines(buf, content)
    buf.write_string("\n")
  }
  buf.to_string()
}

///|
fn run(dir : String) -> Unit raise {
  let output_path = output_path_for_dir(dir)
  let entries = read_bundle_entries(dir, output_path)
  let content = render_bundle(dir, entries)
  @miniio.write_text_file(
    output_path,
    content,
    create_mode=@miniio.CreateMode::CreateOrTruncate,
  )
  @miniio.stdout.write_text(
    "wrote " +
    output_path +
    " with " +
    entries.length().to_string() +
    " files\n",
  )
}

///|
fn main {
  try {
    let args = @miniio.args_get()
    if args.length() == 2 && (args[1] == "-h" || args[1] == "--help") {
      @miniio.stdout.write_text(usage())
      @miniio.exit(0)
    }
    if args.length() != 2 {
      @miniio.stderr.write_text(usage())
      @miniio.exit(2)
    }
    run(args[1])
  } catch {
    err => die(err.to_string())
  }
}
