///|
test "sanitize identifier" {
  assert_eq(sanitize_identifier("demo/a-b.mbt"), "demo_a_b_mbt")
  assert_eq(sanitize_identifier("123-data.json"), "v_123_data_json")
  assert_eq(sanitize_identifier("..."), "bundle")
  assert_eq(safe_identifier("let"), "let_")
  assert_eq(fixture_type_name("sample-dir"), "SampleDirFixture")
}

///|
test "prune paths match normalized relative paths" {
  let prune_paths = normalize_prune_paths(["./nested", "a/../skip.txt", "."])
  assert_true(should_prune_path("nested", prune_paths))
  assert_true(should_prune_path("./skip.txt", prune_paths))
  assert_eq(should_prune_path("nested/data.bin", prune_paths), false)
}

///|
test "ensure output parent dir creates nested directories" {
  let root = "_tmp_embed_files_parent_test"
  @miniio.rmdir(root, recursive=true) catch {
    Noent => ()
    err => raise err
  }
  ensure_output_parent_dir("\{root}/a/b/files.mbt")
  assert_true(@miniio.is_dir("\{root}/a/b"))
  @miniio.rmdir(root, recursive=true)
}

///|
test "ensure output parent dir rejects file parent" {
  let root = "_tmp_embed_files_parent_file"
  @miniio.remove(root) catch {
    Noent => ()
    err => raise err
  }
  @miniio.write_text_file(root, "not a dir", create_mode=CreateOrTruncate)
  let mut failed = false
  ensure_output_parent_dir("\{root}/files.mbt") catch {
    @miniio.Errno::Notdir => failed = true
    err => raise err
  }
  assert_true(failed)
  @miniio.remove_file(root)
}

///|
test "render single file bundle" {
  let rendered = render_bundle("data-file.txt", SingleFile(Text("one\ntwo")))
  assert_true(
    rendered.contains(
      "// Generated by moonbit-community/embed-files from data-file.txt.",
    ),
  )
  assert_eq(rendered.contains("///| Generated"), false)
  assert_true(rendered.contains("let _embed_files_data_file_txt : String ="))
  assert_true(
    rendered.contains(
      "pub let data_file_txt : String = _embed_files_data_file_txt",
    ),
  )
  assert_true(rendered.contains("  #|one\n  #|two\n"))
  assert_eq(rendered.contains("struct"), false)
}

///|
test "render binary file bundle" {
  let rendered = render_bundle(
    "data.bin",
    SingleFile(Binary(([0xFF, 0xAA, 0x00] : Bytes))),
  )
  assert_true(rendered.contains("let _embed_files_data_bin : Bytes ="))
  assert_true(
    rendered.contains("pub let data_bin : Bytes = _embed_files_data_bin"),
  )
  assert_true(rendered.contains("0xFF, 0xAA, 0x00,"))
}

///|
test "render nested directory fixture" {
  let dir = BundleDir::{
    path: "sample-dir",
    entries: [
      EntryFile("a.txt", Text("one\ntwo")),
      EntryDir("nested", {
        path: "sample-dir/nested",
        entries: [EntryFile("data.bin", Binary(([0xFF, 0xAA] : Bytes)))],
      }),
      EntryFile("a-txt", Binary(([0xAA] : Bytes))),
    ],
  }
  let rendered = render_bundle("sample-dir", Directory(dir))
  assert_true(
    rendered.contains(
      "// Generated by moonbit-community/embed-files from sample-dir.",
    ),
  )
  assert_eq(rendered.contains("///| Generated"), false)
  assert_true(rendered.contains("let _embed_files_a_txt : String ="))
  assert_true(rendered.contains("let _embed_files_data_bin : Bytes ="))
  assert_true(rendered.contains("let _embed_files_a_txt_2 : Bytes ="))
  assert_true(rendered.contains("pub struct SampleDirFixture {"))
  assert_true(
    rendered.contains("pub struct SampleDirFixture {\n  a_txt : String"),
  )
  assert_true(rendered.contains("  nested : NestedFixture\n"))
  assert_true(rendered.contains("  a_txt : String\n"))
  assert_true(rendered.contains("  a_txt_2 : Bytes\n"))
  assert_true(rendered.contains("pub struct NestedFixture {"))
  assert_true(rendered.contains("  data_bin : Bytes\n"))
  assert_true(rendered.contains("pub let sample_dir : SampleDirFixture = {"))
  assert_true(rendered.contains("  a_txt: _embed_files_a_txt,\n  nested: {"))
  assert_true(rendered.contains("    data_bin: _embed_files_data_bin,"))
  assert_true(rendered.contains("  a_txt_2: _embed_files_a_txt_2,"))
  assert_eq(rendered.contains("nested_data_bin"), false)
}
